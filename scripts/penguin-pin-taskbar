#!/usr/bin/env bash
# PenguinOS Default Panel Layout Setup
set -euo pipefail

# 1. Update taskbar launchers & Kickoff start button dynamically if Plasma shell is running
SCRIPT='
    var p = panels();
    for (var i = 0; i < p.length; ++i) {
        var ws = p[i].widgets();
        for (var j = 0; j < ws.length; ++j) {
            var type = ws[j].type;
            if (type === "org.kde.plasma.icontasks" || type === "org.kde.plasma.taskmanager") {
                ws[j].currentConfigGroup = ["General"];
                var cur = ws[j].readConfig("launchers") || "";
                if (cur.indexOf("craft-launcher") === -1) {
                    var updated = cur ? cur + ",applications:craft-launcher.desktop" : "applications:craft-launcher.desktop";
                    ws[j].writeConfig("launchers", updated);
                }
            } else if (type === "org.kde.plasma.kickoff" || type === "org.kde.plasma.kicker" || type === "org.kde.plasma.appmenu") {
                ws[j].currentConfigGroup = ["General"];
                ws[j].writeConfig("icon", "penguinos-logo");
            }
        }
    }
'

if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$SCRIPT" >/dev/null 2>&1 || true
elif command -v qdbus >/dev/null 2>&1; then
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$SCRIPT" >/dev/null 2>&1 || true
fi
