#!/usr/bin/env bash
# PenguinOS First-Boot Welcome & Setup Wizard
set -euo pipefail

WELCOME_FLAG="${XDG_CONFIG_HOME:-$HOME/.config}/penguin-welcome-done"

if [ -f "$WELCOME_FLAG" ]; then
    exit 0
fi

# Function to check graphical environment
if command -v kdialog >/dev/null 2>&1; then
    # Apply official default wallpaper on first boot
    if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
        DEFAULT_WP="/usr/share/wallpapers/PenguinOS-Default/contents/images/1920x1080.jpg"
        if [ -f "$DEFAULT_WP" ]; then
            plasma-apply-wallpaperimage "$DEFAULT_WP" >/dev/null 2>&1 || true
        fi
    fi

    # Apply lockscreen wallpaper
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        DEFAULT_WP="/usr/share/wallpapers/PenguinOS-Default/contents/images/1920x1080.jpg"
        kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "file://$DEFAULT_WP" || true
    fi

    # Pin Craft Launcher to panel
    /usr/bin/penguin-pin-taskbar >/dev/null 2>&1 || true

    kdialog --msgbox "Welcome to PenguinOS 1.0-alpha!\n\nYour resilient, immutable KDE Plasma workstation is ready.\n\nKey features pre-configured:\n- Hardware-accelerated media & gaming stack\n- Background atomic OS updates\n- KDE Connect seamless device integration" --title "Welcome to PenguinOS 1.0-alpha" --icon "penguinos-logo"
    
    # Prompt for KDE Connect pairing
    if kdialog --yesno "Would you like to open KDE Connect now to discover and pair your phone/devices?" --title "Device Continuity" 2>/dev/null; then
        kdeconnect-app &
    fi

    # Trigger user-scope applications installer if not present
    if command -v flatpak >/dev/null 2>&1; then
        flatpak --user remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
        nohup flatpak --user install -y flathub \
            com.valvesoftware.Steam \
            org.telegram.desktop \
            io.github.Figma_Linux.figma_linux \
            com.stremio.Stremio >/tmp/penguin-apps-install.log 2>&1 &
    fi

    # Mark welcome completed
    touch "$WELCOME_FLAG"
fi
